{
  "_about": "LeaseResources settings shared by every machine. A machine overrides any of them in config/<machine>.json (lower case), which only that machine edits; a key holding an object there is merged key by key into the default object, any other key replaces the default. Units: cpu in cores, ram and vram in bytes, disk and net in bytes per second, gpu in percent. See README.md for each key.",
  "machines": ["Mistral", "Moosfels", "Stahlwerk", "Teppich", "Altiplano", "Sandbank", "Pulvermaar", "Pektolith"],
  "hostnames": {},

  "headroom": 0.85,
  "headroom_by_dimension": {"disk": 1.0, "net": 1.0, "gpu": 1.0, "cpu": 0.95},
  "margin": 0.25,
  "request_floor": {"cpu": 0.25, "ram": 134217728, "disk": 5000000, "net": 1000000, "gpu": 5, "vram": 268435456},
  "overrun_margin": 0.1,
  "overrun_floor": {"cpu": 0.5, "ram": 268435456, "disk": 20000000, "net": 5000000, "gpu": 10, "vram": 268435456},
  "overrun_samples": 3,

  "trial_seconds": 10,
  "trial_sample_seconds": 0.25,
  "tick_seconds": 1,
  "dispatcher_stall_seconds": 600,
  "sample_seconds": 5,
  "smoothing_seconds": 30,
  "answer_wait_seconds": 6,
  "start_within_minutes": 60,
  "stall_minutes": 30,
  "queue_notice_minutes": 30,
  "log_tail_lines": 30,
  "keep_days": 30,
  "lease_log_max_bytes": 50000000,
  "trial_output_max_bytes": 10000000,
  "compliance_log_max_bytes": 5000000,

  "unleased_check_seconds": 5,
  "unleased_after_seconds": 120,
  "claude_process_names": ["claude", "claude.exe"],
  "tool_shell_markers": ["shell-snapshots", "__claudeCodeScript"],
  "tool_shell_names": [],
  "ignore_command_markers": ["mail.py", "res.py", "house.py"],
  "ignore_process_names": ["conhost.exe", "openconsole.exe", "wslhost.exe"],
  "tool_host_names": ["bash", "bash.exe", "zsh", "sh", "sh.exe", "powershell.exe", "pwsh", "pwsh.exe", "cmd.exe"],

  "allowed_programs": ["python", "pythonw", "py", "powershell", "pwsh"],
  "allowed_roots": ["~/ResilioSync/Services", "~/ResilioSync/Projects", "~/ResilioSync/Tools"],
  "check_local_runs": false,

  "disk_default_bytes_per_s": 150000000,
  "disk_capacity": {},
  "disk_benchmarks": "~/ResilioSync/Harddrives",
  "disk_paths_seconds": 1,
  "disk_skip_mounts": ["/Library/Developer/CoreSimulator", "/System/Volumes/", "/Volumes/Recovery", "/private/var/run/com.apple.security.cryptexd/"],
  "net_default_bytes_per_s": 125000000,
  "net_capacity": {},
  "net_skip": ["vethernet", "vmware", "virtualbox", "hyper-v", "tailscale", "zerotier", "npcap", "bluetooth", "loopback", "isatap", "teredo", "proton", "wireguard", "openvpn", "tap-windows", "nordlynx", "mullvad", "utun"],
  "net_bogus_speeds_mbit": [4294, 4295],
  "file_dimensions": {},

  "mail_script": "",
  "notify": true,

  "reports_via": "files"
}
